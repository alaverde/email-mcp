# Copia este archivo fuera del repositorio, por ejemplo a:
#   %USERPROFILE%\.config\cpanel-mail.env
# y rellena MAIL_PASSWORD ahí. No subas ese archivo a GitHub.
# Los comentarios tienen que ir en su propia línea.

MAIL_USER=usuario@example.com
MAIL_PASSWORD=

IMAP_HOST=mail.example.com
IMAP_PORT=993

SMTP_HOST=mail.example.com
SMTP_PORT=465

# true comprueba el certificado. Déjalo así si cPanel usa un certificado válido.
MAIL_TLS_REJECT_UNAUTHORIZED=true

# El servidor no envía correo hasta que esto sea true.
MAIL_ALLOW_SEND=false

# El borrado permanente (EXPUNGE) queda desactivado.
MAIL_ALLOW_EXPUNGE=false

# Opcional. Si se omite, se detecta la carpeta por el atributo IMAP \Trash, \Drafts o \Sent.
# TRASH_MAILBOX=INBOX.Trash
# DRAFTS_MAILBOX=INBOX.Drafts
# SENT_MAILBOX=INBOX.Sent

# Nombre visible del remitente. Por defecto se usa MAIL_USER.
# MAIL_FROM_NAME=Tu nombre
